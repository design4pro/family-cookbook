{
  "expo": {
    "name": "Cookbook T03 Proof",
    "slug": "cookbook-t03-proof",
    "scheme": "cookbook-t03-proof",
    "version": "0.0.1",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "pro.design4.cookbook.t03proof"
    },
    "android": {
      "package": "pro.design4.cookbook.t03proof"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "web": {
      "output": "static"
    }
  }
}
