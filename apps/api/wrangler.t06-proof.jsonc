{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-cookbook-t06-proof",
  "main": "src/proofs/t06-worker.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "family-cookbook-t06-local", "database_id": "local-t06-only", "migrations_dir": "migrations" },
    { "binding": "JOURNAL", "database_name": "family-cookbook-t06-journal-local", "database_id": "local-t06-journal-only" }
  ],
  "r2_buckets": [
    { "binding": "ACTIVE", "bucket_name": "family-cookbook-t06-active" },
    { "binding": "RECOVERY", "bucket_name": "family-cookbook-t06-recovery" }
  ],
  "queues": { "consumers": [{ "queue": "family-cookbook-t06-proof", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 0 }] }
}
