{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-cookbook-t07-local",
  "main": "src/proofs/t07-worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "family-cookbook-t07-local", "database_id": "local-t07-only", "migrations_dir": "migrations" }],
  "assets": { "directory": "../app/dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash" }
}
